# Copy this file to .env and fill in your values
# Never commit .env to version control

# Database
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=semantic_search
DATABASE_URL=postgresql+asyncpg://appuser:apppassword@localhost:5432/semantic_search

# OpenAI (optional)
# If set, uses text-embedding-3-small for semantic search and gpt-4o-mini for summaries.
# If NOT set, falls back to the free local all-MiniLM-L6-v2 model (no quota, no cost).
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# App settings
APP_ENV=development
LOG_LEVEL=INFO
SEED_ON_STARTUP=true   # set to false in production
